+// Local patch (makerbench-hwe 0001): fall back to OpenRouter (same model-id
+// namespace) when the direct provider key is absent, so Claude/Gemini picks
+// work with only OPENROUTER_API_KEY set.
+function providerFor(modelId: string): ChatProvider {
+  const direct = directProviderFor(modelId);
+  if (direct === 'anthropic' && !env('ANTHROPIC_API_KEY')) return 'openrouter';
+  if (direct === 'google' && !env('GOOGLE_API_KEY')) return 'openrouter';
+  return direct;
